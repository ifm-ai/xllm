From dafa74b70de6423263f69e0b5f01cc4374aba4b0 Mon Sep 17 00:00:00 2001
From: Ahmad Chamma <ahmad.chamma723@gmail.com>
Date: Wed, 21 Oct 2026 13:35:57 +0400
Subject: [PATCH] Fold xLLM residual_multiplier into o_proj and down_proj on
 export

xLLM mup depth scaling multiplies each attention and FFN output by
model.residual_multiplier (m_L^-alpha) before the residual add. K2Horizon
adds the outputs unscaled, so depth-scaled checkpoints converted without
errors but gave wrong outputs. Conversion now reads the multiplier from the
checkpoint config and folds it into o_proj and down_proj, which have no
bias; MoE and MoVA layers are rejected when it is not 1. Checkpoints with
multiplier 1 (no mup, or width-only mup) convert unchanged.
---
 tests/huggingface/test_conversion.py        | 37 +++++++++++++++++++++
 xbridges/huggingface/README.md              |  9 +++++
 xbridges/huggingface/validate.py            |  6 ++--
 xbridges/huggingface/xllm_to_hf_main.py     | 24 +++++++++++--
 xbridges/huggingface/xllm_to_hf_parallel.py |  2 ++
 5 files changed, 73 insertions(+), 5 deletions(-)

diff --git a/tests/huggingface/test_conversion.py b/tests/huggingface/test_conversion.py
index 0cdb189..19bbf70 100644
--- a/tests/huggingface/test_conversion.py
+++ b/tests/huggingface/test_conversion.py
@@ -147,6 +147,43 @@ def test_unsupported_semantics_rejected(field, value):
         bridge.convert_config_xllm_to_hf(config, SimpleNamespace(pad_token_id=31, bos_token_id=0, eos_token_id=1))
 
 
+def test_residual_multiplier_folded_into_branch_outputs():
+    cfg, model, sd, _ = fixture_model('dense')
+    plain = bridge.convert_state_dict_xllm_to_hf(model.state_dict(), cfg, dict(sd))
+    folded = bridge.convert_state_dict_xllm_to_hf(model.state_dict(), cfg, dict(sd), residual_multiplier=0.25)
+    for key, value in plain.items():
+        if key.endswith(('self_attn.o_proj.weight', 'mlp.down_proj.weight')):
+            torch.testing.assert_close(folded[key], 0.25 * value, rtol=0, atol=0)
+        else:
+            torch.testing.assert_close(folded[key], value, rtol=0, atol=0)
+
+
+def test_folded_residual_multiplier_matches_scaled_branches():
+    # x + m * W h computed with unscaled weights equals x + (m W) h after folding
+    cfg, model, sd, _ = fixture_model('dense')
+    folded = bridge.convert_state_dict_xllm_to_hf(model.state_dict(), cfg, dict(sd), residual_multiplier=0.25)
+    model.load_state_dict(folded)
+    plain_model = bridge.K2HorizonForCausalLM(cfg).eval()
+    plain_model.load_state_dict(bridge.convert_state_dict_xllm_to_hf(model.state_dict(), cfg, dict(sd)))
+    layer, plain_layer = model.model.layers[0], plain_model.model.layers[0]
+    h = torch.randn(1, 5, cfg.hidden_size)
+    torch.testing.assert_close(layer.mlp(h), 0.25 * plain_layer.mlp(h))
+
+
+def test_residual_multiplier_config():
+    config = source_config('dense')
+    assert bridge.residual_multiplier(config) == 1.0
+    config['model']['residual_multiplier'] = 0.25
+    assert bridge.residual_multiplier(config) == 0.25
+    tokenizer = SimpleNamespace(pad_token_id=31, bos_token_id=0, eos_token_id=1)
+    bridge.convert_config_xllm_to_hf(config, tokenizer)
+    for kind in ('moe', 'mova'):
+        sparse = source_config(kind)
+        sparse['model']['residual_multiplier'] = 0.25
+        with pytest.raises(ValueError, match='residual_multiplier'):
+            bridge.convert_config_xllm_to_hf(sparse, tokenizer)
+
+
 @pytest.mark.parametrize('fault', ['missing', 'unused', 'shape', 'extra_expert', 'extra_value'])
 def test_invalid_checkpoint_rejected(fault):
     cfg, model, sd, _ = fixture_model('mova')
diff --git a/xbridges/huggingface/README.md b/xbridges/huggingface/README.md
index 16854a6..f4f9232 100644
--- a/xbridges/huggingface/README.md
+++ b/xbridges/huggingface/README.md
@@ -20,6 +20,11 @@ python -m xbridges.huggingface.xllm_to_hf_main \
   directory; existing nonempty directories are never overwritten.
 * RoPE is derived from the source checkpoint. Conversion does not implicitly
   apply the additional YaRN context extension used by the published 0.9B model.
+* Checkpoints trained with xLLM `mup` depth scaling scale each attention and
+  FFN output by `model.residual_multiplier` before the residual add.
+  K2Horizon adds them unscaled, so conversion folds the multiplier into
+  `o_proj` and `down_proj` (dense layers only). Checkpoints with multiplier 1
+  (no `mup`, or width-only `mup`) convert unchanged.
 
 ### Parallel Conversion
 For large models, `xllm_to_hf_parallel` converts layers in parallel and writes
@@ -44,6 +49,10 @@ python -m xbridges.huggingface.hf_to_xllm_main \
 * Run with `--help` for dtype, rank batching, Slurm-array, and resume options.
 * Output is one `full_model.tpNN` directory per TP rank plus `config.json`. Load
   it in xLLM with `--base_model_dir`; it is not a resumable training checkpoint.
+* A model exported from an xLLM `mup` depth-scaled checkpoint has the residual
+  multiplier folded into its weights and converts back with multiplier 1. Do
+  not load it into a run with `mup` depth scaling, which would apply the
+  multiplier a second time.
 
 ## Validating Conversion
 
