diff --git a/xbridges/huggingface/xllm_to_hf_main.py b/xbridges/huggingface/xllm_to_hf_main.py
index aa26da8..5140598 100644
--- a/xbridges/huggingface/xllm_to_hf_main.py
+++ b/xbridges/huggingface/xllm_to_hf_main.py
@@ -100,6 +100,11 @@ def _resolve_attention_norm_key(key, state_dict, layer, hf_config):
     return present[0] if present else legacy
 
 
+def residual_multiplier(xllm_config):
+    """Multiplier on attention/FFN outputs before the residual add (xLLM mup depth scaling)."""
+    return float(xllm_config['model'].get('residual_multiplier', 1.0))
+
+
 def convert_config_xllm_to_hf(xllm_config, tokenizer):
     assert xllm_config['model']['apply_rmsnorm'] == True
     assert xllm_config['model']['swiglu'] == True
@@ -115,6 +120,8 @@ def convert_config_xllm_to_hf(xllm_config, tokenizer):
     for option in ('two_hop_residual', 'rescale_nffn', 'causal_norm_weight'):
         if model.get(option, False):
             raise ValueError(f'IFM K2Horizon does not implement {option}')
+    if residual_multiplier(xllm_config) != 1.0 and (model['num_experts'] > 0 or model.get('num_values', 0) > 0):
+        raise ValueError('Folding residual_multiplier is only implemented for dense attention and FFN layers')
 
     if xllm_config['model'].get('head_dim', None) is not None:
         head_dim = xllm_config['model']['head_dim']
@@ -224,7 +231,13 @@ def _restore_expert_axis(key, weight, hf_config):
 
 
 def convert_state_dict_xllm_to_hf(
-        hf_state_dict, hf_config, xllm_state_dict, layers=None, include_output=True):
+        hf_state_dict, hf_config, xllm_state_dict, layers=None, include_output=True, residual_multiplier=1.0):
+    """Map xLLM weights to K2Horizon weights.
+
+    K2Horizon adds attention and FFN outputs to the residual stream unscaled, so an
+    xLLM residual_multiplier (mup depth scaling) is folded into the last projection
+    of each branch (o_proj and down_proj), which have no bias.
+    """
     num_layers = hf_config.num_hidden_layers
     num_experts = hf_config.num_experts
     hidden_size = hf_config.hidden_size
@@ -287,6 +300,9 @@ def convert_state_dict_xllm_to_hf(
                 for expert in range(mova_num_experts):
                     state_dict[hf_key.format(layer=layer, expert=expert)] = \
                         weight[expert]
+            elif residual_multiplier != 1.0 and xllm_key.endswith(('.attention.wo.weight', '.nffn.fc2.weight')):
+                weight = xllm_state_dict[xllm_key]
+                state_dict[hf_key] = (weight.float() * residual_multiplier).to(weight.dtype)
             elif '.moe.experts.' in xllm_key:
                 weight = _restore_expert_axis(xllm_key, xllm_state_dict[xllm_key], hf_config)
                 expected_shape = (num_experts, *hf_state_dict[hf_key.format(layer=layer, expert=0)].shape)
@@ -433,8 +449,9 @@ def main(xllm_dir='ckpts/xllm-30b-a3b',
         raise ValueError(f'Refusing to overwrite nonempty output directory: {save_dir}')
     hf_tokenizer = AutoTokenizer.from_pretrained(
         tokenizer_dir, trust_remote_code=True)
+    xllm_config = json.load(open(f'{xllm_dir}/config.json'))
     hf_config = convert_config_xllm_to_hf(
-        xllm_config=json.load(open(f'{xllm_dir}/config.json')),
+        xllm_config=xllm_config,
         tokenizer=hf_tokenizer)
     hf_config.dtype = output_dtype
     with torch.device('meta'):
@@ -472,7 +489,8 @@ def main(xllm_dir='ckpts/xllm-30b-a3b',
             hf_config=hf_model.config,
             xllm_state_dict=xllm_state_dict,
             layers=range(layer_l, layer_r),
-            include_output=layer_r == hf_config.num_hidden_layers)
+            include_output=layer_r == hf_config.num_hidden_layers,
+            residual_multiplier=residual_multiplier(xllm_config))
 
         del xllm_state_dict
         gc.collect()
