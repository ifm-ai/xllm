+// Local H100 patch: GQA backward with every Q head of a KV head in one CTA
+// (reader-pair K/V reuse): K / V loaded once, dK / dV kept in registers and
+// stored once, so no fp32 dK / dV accumulators, zero fill or cast kernel.
+// XATTN_PAIR=0 restores the per-Q-head CTAs. D = V = 256 only: at D = 128
+// (4B, H 32 / KV 8, L 8192) the serialized readers leave too few CTAs (slower).
+inline bool FlashSCABwdSm90PairKVReuse(AttentionBwdParams const& params) {
+  static const bool enabled = [] {
+    char const* env = std::getenv("XATTN_PAIR");
+    return env == nullptr || env[0] != '0';
+  }();
+  // Keys longer than queries (a previous chunk) need the two-component dV path.
+  return enabled && params.h != params.h_k && params.h % 2 == 0 &&
+      (params.h / 2) % params.h_k == 0 && params.seqlen_k == params.seqlen_q;
+}
