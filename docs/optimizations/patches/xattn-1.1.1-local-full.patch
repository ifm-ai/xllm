+// Eight elements per thread: 2 x 16-byte loads, one 16-byte store.
+template <typename Element>
+__global__ void AttentionCastGroupedKVGradsVec8Kernel(
+    int64_t dk_vecs, const float4* __restrict__ dk_input,
+    uint4* __restrict__ dk_output, int64_t dv_vecs,
+    const float4* __restrict__ dv_input, uint4* __restrict__ dv_output) {
+  static_assert(sizeof(Element) == 2);
+  int64_t const idx =
+      int64_t(blockIdx.x) * int64_t(blockDim.x) + int64_t(threadIdx.x);
+  auto cast8 = [](const float4* in, uint4* out) {
+    float4 const a = in[0];
+    float4 const b = in[1];
+    float const f[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+    uint4 r;
+    Element* e = reinterpret_cast<Element*>(&r);
+    #pragma unroll
+    for (int i = 0; i < 8; ++i) { e[i] = static_cast<Element>(f[i]); }
+    *out = r;
+  };
+  if (idx < dk_vecs) { cast8(dk_input + 2 * idx, dk_output + idx); }
+  if (idx < dv_vecs) { cast8(dv_input + 2 * idx, dv_output + idx); }
+}
